<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Aerospike.Test</RootNamespace>
    <AssemblyName>AerospikeTest</AssemblyName>
    <TestingExtensionsProfile>Default</TestingExtensionsProfile>
    <IsPackable>false</IsPackable>
    <Version>8.5.1</Version>
    <Company>Aerospike</Company>
    <Authors>Aerospike</Authors>
    <Platforms>AnyCPU</Platforms>
    <IsTestProject>true</IsTestProject>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>false</TestingPlatformDotnetTestSupport>
    <SignAssembly>True</SignAssembly>
    <DelaySign>True</DelaySign>
    <AssemblyOriginatorKeyFile>../AerospikePublicKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.4.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="LuaResources\average_example.lua" />
    <EmbeddedResource Include="LuaResources\filter_example.lua" />
    <EmbeddedResource Include="LuaResources\record_example.lua" />
    <EmbeddedResource Include="LuaResources\sum_example.lua" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Compatibility\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AerospikeClient\AerospikeClient.csproj" />
    <ProjectReference Include="Compatibility\released-8.5.0\Released850Implementer\Released850Implementer.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyReleased850CompatibilityFixture" AfterTargets="Publish">
    <ItemGroup>
      <Released850CompatibilityFixture Include="Compatibility\released-8.5.0\Released850Implementer\bin\$(Configuration)\net8.0\Released850Implementer.*" />
    </ItemGroup>
    <Copy SourceFiles="@(Released850CompatibilityFixture)"
          DestinationFolder="$(PublishDir)Compatibility\released-8.5.0\Released850Implementer\"
          SkipUnchangedFiles="true"
          Condition="'@(Released850CompatibilityFixture)' != ''" />
  </Target>
</Project>